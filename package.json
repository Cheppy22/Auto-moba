{
  "name": "auto-moba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single-player autobattler MOBA prototype (occult pocket dimension)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "e2e": "playwright test",
    "sim": "tsx tools/run-match.ts",
    "balance": "tsx tools/balance.ts",
    "balance:pairwise": "tsx tools/pairwise.ts",
    "diagnose": "tsx tools/diagnose.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "preact": "^11.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
